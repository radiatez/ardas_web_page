# Runtime
APP_ENV=local
SITE_URL=http://localhost:3000
DEFAULT_LOCALE=tr
SUPPORTED_LOCALES=tr,en

# PostgreSQL 18 / Neon in production (development-only placeholder below)
DATABASE_URL=postgresql://ardas:ardas@localhost:5432/ardas

# Server configuration
DEALER_PORTAL_URL=https://online.bsdotomotiv.com/web
UPLOAD_MAX_SIZE_BYTES=10485760
CANDIDATE_RETENTION_DAYS=
CONTACT_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# Auth0 EU tenant (server-only secrets)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# AWS eu-central-1: S3 public/protected/quarantine + GuardDuty + SES
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BUCKET=
S3_PROTECTED_BUCKET=
S3_QUARANTINE_BUCKET=
S3_DATABASE_BACKUP_BUCKET=
SES_REGION=eu-central-1
EMAIL_SENDER=
CONTACT_NOTIFICATION_RECIPIENT=
HR_NOTIFICATION_RECIPIENT=

# Sentry Germany region; PII scrubbing remains mandatory
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
