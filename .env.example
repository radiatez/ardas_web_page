# APP / PUBLIC — non-secret unless stated otherwise
# Required: local, staging, production. Allowed: local | test | staging | production.
APP_ENV=local
# Required in every environment. Use the canonical HTTPS origin outside local.
SITE_URL=http://localhost:3000
# Required with Auth0 outside local. Usually equal to SITE_URL.
APP_BASE_URL=http://localhost:3000
# Optional HTTPS base for CMS-managed public S3/CDN objects.
PUBLIC_MEDIA_BASE_URL=
# Required in all environments; fixed non-secret locale contract.
DEFAULT_LOCALE=tr
# Required in all environments; fixed non-secret locale contract.
SUPPORTED_LOCALES=tr,en

# DATABASE — secret; Neon pooled runtime and direct migration URLs are separate
# Required at runtime. Use the pooled URL in staging/production.
DATABASE_URL=postgresql://ardas:ardas@localhost:5432/ardas
# Required by staging/production migration and seed jobs. Use the direct URL.
MIGRATION_DATABASE_URL=

# AUTH0 EU — required for staging/production admin access
# Required server configuration in staging/production; domain is non-secret.
AUTH0_DOMAIN=
# Required server configuration in staging/production; client ID is non-secret.
AUTH0_CLIENT_ID=
# Required server secret in staging/production.
AUTH0_CLIENT_SECRET=
# Required high-entropy session secret; never expose it to the browser.
AUTH0_SECRET=

# AWS STORAGE — server-only configuration; eu-central-1
# Required non-secret configuration wherever AWS storage/SQS is enabled.
AWS_REGION=eu-central-1
# Required only when workload identity is unavailable; secrets.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Required non-secret identifiers for CMS public media, protected CVs and CV
# quarantine respectively; staging/production resources must be isolated.
S3_PUBLIC_BUCKET=
S3_PROTECTED_BUCKET=
S3_QUARANTINE_BUCKET=
# Optional runtime/non-secret identifier; required by the approved backup job.
S3_DATABASE_BACKUP_BUCKET=

# GUARDDUTY / EVENTBRIDGE / SQS — server-only
# Required server-only configuration before production career form enablement.
S3_GUARDDUTY_SCAN_QUEUE_URL=
# GuardDuty S3 protection, EventBridge rules, SQS DLQ and CloudWatch alarms are
# provider-side resources; they have no additional application environment key.

# SES — non-secret operational configuration; required before public forms enable
# Required non-secret region in staging/production when notifications are active.
SES_REGION=eu-central-1
# Required server-only operational addresses before the associated form enables.
EMAIL_SENDER=
CONTACT_NOTIFICATION_RECIPIENT=
HR_NOTIFICATION_RECIPIENT=

# SENTRY / MONITORING — server-only; provider-side PII scrubbing is mandatory
# Optional server-only DSN until staging/production monitoring is provisioned.
SENTRY_DSN=
# Optional staging/production build/release secret; not required at runtime.
SENTRY_AUTH_TOKEN=

# DEALER PORTAL — HTTPS only; non-secret configuration
# Optional environment fallback in all environments; validated SiteSetting wins.
DEALER_PORTAL_URL=https://online.bsdotomotiv.com/web
# Optional non-secret host allowlist in all environments.
DEALER_PORTAL_ALLOWED_HOSTS=online.bsdotomotiv.com

# RETENTION / LEGAL VERSION — required before production form enablement
# Non-secret; each duration is required before its production data flow enables.
CANDIDATE_RETENTION_DAYS=
CONTACT_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=
# Optional non-secret shared fallback; prefer the explicit production versions.
FORM_PRIVACY_NOTICE_VERSION=
# Required non-secret approved versions before the associated production form.
CAREER_PRIVACY_NOTICE_VERSION=
CONTACT_PRIVACY_NOTICE_VERSION=

# FEATURE FLAGS — public forms default fail-closed
# Required non-secret booleans in every environment.
PUBLIC_CONTACT_FORM_ENABLED=false
PUBLIC_CAREER_FORM_ENABLED=false
# Keep false until the gated fields receive explicit business/legal approval.
CAREER_APPROVAL_GATED_FIELDS_ENABLED=false

# INTERNAL JOBS / SECURITY — server-only secrets, minimum 32 random characters
# Required in staging/production before scheduled workers or forms are enabled.
CRON_SECRET=
RATE_LIMIT_HASH_SECRET=

# TEST ONLY — never set in staging/production
# Optional local/test-only secret connection.
TEST_DATABASE_URL=
# Optional local/test-only non-secret URLs/flags.
E2E_BASE_URL=http://127.0.0.1:3100
E2E_UI_TEST_SURFACE=
SCREENSHOT_BASE_URL=http://127.0.0.1:3100
